<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ApkForge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forge_accent</item>
        <item name="android:statusBarColor">@color/forge_bg</item>
        <item name="android:navigationBarColor">@color/forge_bg</item>
        <item name="android:windowBackground">@color/forge_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ForgeKey" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/forge_fg</item>
        <item name="backgroundTint">@color/forge_key</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="ForgeKey.Num">
        <item name="backgroundTint">@color/forge_key</item>
        <item name="android:textColor">@color/forge_fg</item>
    </style>

    <style name="ForgeKey.Op">
        <item name="backgroundTint">@color/forge_key_op</item>
        <item name="android:textColor">@color/forge_accent</item>
    </style>

    <style name="ForgeKey.Fn">
        <item name="backgroundTint">@color/forge_key_fn</item>
        <item name="android:textColor">@color/forge_muted</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ForgeKey.Eq">
        <item name="backgroundTint">@color/forge_key_eq</item>
        <item name="android:textColor">@color/forge_fg</item>
    </style>
</resources>
