# Copy to /etc/forge/agent.env on the VM. Never commit the real file.
# GitHub PAT with: repo, workflow, pull_requests. Fine-grained preferred.
GITHUB_TOKEN=
GITHUB_OWNER=therockstarplaylist-bot
GITHUB_REPO=apk-forge-pipeline

# Default: local Ollama. No cloud key required.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional cloud swap. If LLM_API_BASE is set, agents use it instead of Ollama.
# Example: https://api.openai.com/v1  or  https://api.x.ai/v1
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# SSH allowlist — set to your public IPv4. Never 0.0.0.0/0.
SSH_ALLOW_IP=
